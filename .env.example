# ==============================================================================
# .env.example — plantilla versionada de configuración del entorno
#
# REGLAS:
#   * Este archivo SÍ se versiona en Git.
#   * NO debe contener secretos reales: solo placeholders y valores de ejemplo.
#   * El archivo real es `.env`, excluido de Git por .gitignore.
#   * Ningún secreto debe aparecer en código, logs, commits ni fixtures.
#
# USO:
#   cd producto
#   cp .env.example .env      (Windows: copy .env.example .env)
#   # editar .env y asignar valores locales reales
#
# Las variables marcadas como OBLIGATORIA usan la sintaxis `${VAR:?...}` en
# docker-compose.yml: Compose falla de forma explícita si no se definen, en lugar
# de arrancar con credenciales por defecto.
# ==============================================================================

# ------------------------------------------------------------------------------
# IDENTIDAD DEL ENTORNO
# ------------------------------------------------------------------------------
APP_NAME=backend-riesgo-legal
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# POSTGRESQL + pgvector  (servicio lógico 1/4)
#
# La aplicación no crea ni migra el esquema en esta etapa: solo comprueba
# conectividad y disponibilidad de la extensión vectorial.
# ------------------------------------------------------------------------------
POSTGRES_USER=app
# OBLIGATORIA — asignar un valor local real en .env. Nunca versionar el real.
POSTGRES_PASSWORD=CHANGE_ME_local_only_not_a_real_secret
POSTGRES_DB=riesgo_legal
POSTGRES_PORT=5432
# Ajustes de rendimiento de PostgreSQL.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=100

# ------------------------------------------------------------------------------
# BACKEND (API + modelo de embeddings)  (servicio lógico 2/4)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
# Orígenes CORS explícitos, separados por coma. No usar "*".
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Autenticación y sesiones ----------------------------------------------
# Identidad esperada en los JWT emitidos por este backend.
SECURITY_JWT_ISSUER=riesgo-legal-backend
SECURITY_JWT_AUDIENCE=riesgo-legal-web
# JSON de claves HS256. Cada secreto se genera con al menos 32 bytes aleatorios
# y se conserva fuera del repositorio. El valor es deliberadamente inválido para
# impedir que se use por accidente como clave real.
SECURITY_JWT_KEYRING_JSON={"local":"REEMPLAZAR_CON_SECRETO_BASE64URL_DE_32_BYTES"}
SECURITY_JWT_ACTIVE_KID=local
SECURITY_REFRESH_COOKIE_NAME=riesgo_legal_refresh
# En desarrollo puede ser False si se sirve por HTTP local. Fuera de desarrollo
# debe ser True; la aplicación rechaza una configuración menos estricta.
SECURITY_REFRESH_COOKIE_SECURE=False

# --- Modelo de embeddings -----------------------------------------------------
# Se ejecuta como librería local dentro del contenedor backend; no existe ni debe
# crearse un servicio independiente para los embeddings.
BGE_M3_MODEL_ID=BAAI/bge-m3
# Dimensionalidad de salida del modelo. Es una propiedad del modelo: los vectores
# de otra longitud son incompatibles con el almacén vectorial.
EMBEDDING_DIMENSIONS=1024
# Ruta DENTRO del contenedor; debe coincidir con el punto de montaje del volumen
# de caché. Si diverge, el modelo se re-descarga en cada recreación.
BGE_M3_CACHE_DIR=/home/appuser/.cache/bge-m3
# False = el servicio arranca aunque el modelo todavía no se haya descargado.
BGE_M3_REQUIRED_AT_STARTUP=False

# ------------------------------------------------------------------------------
# FRONTEND  (servicio lógico 3/4)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# URL del endpoint de salud del backend tal como la ve el NAVEGADOR (no la red
# interna de contenedores). Se inyecta en tiempo de build.
VITE_BACKEND_HEALTH_URL=http://localhost:8000/health

# ------------------------------------------------------------------------------
# AIRFLOW  (servicio lógico 4/4)
#
# Se materializa en tres contenedores de la misma imagen (inicialización,
# scheduler y webserver). Sus metadatos usan SQLite sobre el volumen dedicado
# `airflow_db`, no la base de datos de la aplicación.
# ------------------------------------------------------------------------------
AIRFLOW_PORT=8080
# Clave Fernet de Airflow. Opcional en desarrollo: si se deja vacía, Airflow la
# deriva internamente. Puede generarse con:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_local_only_not_a_real_secret
AIRFLOW_ADMIN_USER=admin
# OBLIGATORIA cuando se activa el perfil `airflow`. Solo desarrollo local.
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_local_only_not_a_real_secret
AIRFLOW_ADMIN_EMAIL=admin@example.local

# ------------------------------------------------------------------------------
# LÍMITES DE RECURSOS
#
# Techos de memoria para reproducibilidad y control de recursos, no reservas.
# Se inspiran en la configuración de referencia del proyecto:
#   16 GB = 8 GB PostgreSQL + 4 GB backend + 4 GB servicios auxiliares y SO.
#
# Reducirlos en equipos con menos recursos es legítimo: son límites superiores y
# no alteran el comportamiento funcional del sistema. Si la configuración de
# referencia resulta inviable en un equipo, debe documentarse como tal en lugar
# de asumir que el requisito ha cambiado.
# ------------------------------------------------------------------------------
POSTGRES_MEM_LIMIT=8g
BACKEND_MEM_LIMIT=4g
FRONTEND_MEM_LIMIT=256m
AIRFLOW_SCHEDULER_MEM_LIMIT=1g
AIRFLOW_WEBSERVER_MEM_LIMIT=1g
